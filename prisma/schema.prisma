generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ─────────────────────────────────────────────────────────────
// Auth (NextAuth) models
// ─────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  phone          String?
  image          String?
  role           String    @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  quotes   Quote[]
  bookings Booking[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// Moving domain
// ─────────────────────────────────────────────────────────────

/// An instant quote generated from a customer's move details, photos and items.
model Quote {
  id        String   @id @default(cuid())
  reference String   @unique // human-friendly, e.g. BBM-4F9K2

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Contact (captured even before signup)
  contactName  String?
  contactEmail String?
  contactPhone String?

  // Move details
  originAddress String
  originZip     String?
  destAddress   String
  destZip       String?
  distanceMiles Float   @default(0)
  homeSize      String  // STUDIO | ONE_BED | TWO_BED | THREE_BED | FOUR_BED_PLUS | OFFICE | OTHER
  originFloor   Int     @default(0)
  destFloor     Int     @default(0)
  originElevator Boolean @default(false)
  destElevator   Boolean @default(false)
  preferredDate DateTime?
  flexibleDates Boolean @default(false)

  // Inventory / analysis
  itemsDescription String? // free text from customer
  items            Json?   // structured item list [{name, quantity, category, bulky}]
  photos           Json?   // array of photo refs [{url, note}]
  estimatedVolumeCuFt Float @default(0)
  estimatedWeightLbs  Float @default(0)
  laborHours          Float @default(0)
  crewSize            Int   @default(2)

  addons Json? // selected add-ons ["packing","storage",...]

  // Generated pricing tiers snapshot
  tiers        Json    // [{id,name,price,summary,inclusions[]}]
  breakdown    Json?   // full itemized breakdown {lineItems,addonItems,baseSubtotal,...}
  aiSummary    String? // human explanation of how the quote was built
  aiConfidence String  @default("estimate") // vision | heuristic | estimate

  status    String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | BOOKED | EXPIRED
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking?
}

/// A confirmed, scheduled move.
model Booking {
  id        String   @id @default(cuid())
  reference String   @unique // BBM-B-XXXX

  quoteId String @unique
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  selectedTier String // basic | standard | premium
  totalAmount  Float
  depositAmount Float
  balanceAmount Float

  scheduledDate DateTime
  timeSlot      String // "8:00 AM – 10:00 AM"

  crewId String?
  crew   Crew?   @relation(fields: [crewId], references: [id], onDelete: SetNull)

  status String @default("CONFIRMED") // CONFIRMED | SCHEDULED | CREW_ASSIGNED | EN_ROUTE | LOADING | IN_TRANSIT | UNLOADING | COMPLETED | CANCELLED

  // Tracking (simulated live location)
  trackingEnabled Boolean @default(true)
  crewLat  Float?
  crewLng  Float?
  etaMinutes Int?

  payment  Payment?
  events   TrackingEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount   Float
  kind     String // DEPOSIT | BALANCE
  status   String @default("PAID") // PENDING | PAID | REFUNDED
  method   String @default("card")
  last4    String?
  reference String @unique // txn ref
  createdAt DateTime @default(now())
}

model TrackingEvent {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  status  String // maps to Booking.status stages
  title   String
  detail  String?
  lat     Float?
  lng     Float?
  createdAt DateTime @default(now())
}

model Crew {
  id       String @id @default(cuid())
  name     String // "Team Kodiak"
  lead     String
  size     Int    @default(3)
  phone    String?
  active   Boolean @default(true)

  bookings Booking[]
}

/// Company-editable pricing guidelines. Single active row (isActive).
model PricingConfig {
  id       String  @id @default(cuid())
  isActive Boolean @default(true)

  baseFee            Float @default(149)   // truck + dispatch
  ratePerHourPerMover Float @default(65)   // labor
  ratePerMile        Float @default(1.25)  // long-distance travel
  freeMileRadius     Float @default(25)    // miles included before per-mile kicks in
  ratePerCuFt        Float @default(0.55)  // volume component
  stairsFeePerFlight Float @default(45)
  noElevatorSurcharge Float @default(35)
  depositPercent     Float @default(0.20)

  // Add-on prices
  packingService     Float @default(0.40)  // multiplier on labor, expressed as fraction added
  packingFlat        Float @default(280)
  storageMonthly     Float @default(180)
  specialtyItemFee   Float @default(120)   // piano, safe, gym equipment (each)
  insuranceFullValue Float @default(0.015) // fraction of declared value

  // Tier multipliers over the computed base
  tierBasicMult    Float @default(1.0)
  tierStandardMult Float @default(1.28)
  tierPremiumMult  Float @default(1.6)

  notes     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
